@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="container mt-5 text-center">
    <h2 class="mt-4">@ViewData["Title"]</h2>

    <p class="mt-3">
        This page outlines the privacy policy of the RePurpose platform.
    </p>

    <h4>Data Collection</h4>
    <p>
        We collect limited personal information to provide a better user experience, including names, email addresses, and product interaction data.
    </p>

    <h4>Data Usage</h4>
    <p>
        Your information is used solely to operate and improve our services. We do not sell or share your data with third parties without consent.
    </p>

    <h4>Cookies</h4>
    <p>
        Our website uses cookies to improve performance and analyze traffic.
    </p>

    <h4>Security</h4>
    <p>
        We implement industry-standard measures to protect your personal data.
    </p>

    <h4>Contact Us</h4>
    <p>
        If you have questions about our privacy policy, please contact us at support@repurpose.com.
    </p>
</div>