@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center my-5">
    <h1 class="display-4">Reduce E-Waste, Power Innovation</h1>
    <p class="lead">Shop affordable, eco-friendly electronic components repurposed from old devices.</p>
    <a href="/Products" class="btn btn-success btn-lg mt-3">Browse Components</a>
</div>

<div class="container my-5">
    <div class="row text-center">
        <div class="col-md-4">
            <img src="~/images/sustainable1.svg" alt="Sustainable" class="mb-3" width="150" />
            <h5>Eco-Friendly</h5>
            <p>Each purchase reduces electronic waste and supports a cleaner planet.</p>
        </div>
        <div class="col-md-4">
            <img src="~/images/affordable.svg" alt="Affordable" class="mb-3" width="150" />
            <h5>Affordable</h5>
            <p>High-quality components at a fraction of the cost of new parts.</p>
        </div>
        <div class="col-md-4">
            <img src="~/images/quality.svg" alt="Quality Checked" class="mb-3" width="100" />
            <h5>Quality Tested</h5>
            <p>All parts are inspected and tested for performance and reliability.</p>
        </div>
    </div>
</div>

<div class="bg-light py-5">
    <div class="container text-center">
        <h2>Join the Movement</h2>
        <p class="mb-4">Help us turn discarded electronics into usable components and build a sustainable future.</p>
        <a href="/Home/About" class="btn btn-outline-dark">Learn More</a>
    </div>
</div>
