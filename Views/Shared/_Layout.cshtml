<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RePurpose</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/RePurpose.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
   <header>
    <nav class="navbar navbar-expand-sm navbar-dark bg-success border-bottom box-shadow">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-recycle me-2"></i>RePurpose
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav me-auto">
                    
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Products
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Category" asp-route-id="processors">Processors</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Category" asp-route-id="memory">Memory</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Category" asp-route-id="storage">Storage</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Category" asp-route-id="graphics">Graphics Cards</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Index">All Products</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                </ul>
                <form class="d-flex me-2" asp-controller="Products" asp-action="Search" method="get">
                    <input class="form-control" type="search" placeholder="Search parts..." aria-label="Search" name="q">
                    <button class="btn btn-light ms-2" type="submit"><i class="fa-solid fa-search"></i></button>
                </form>
                <div class="d-flex">
                    <a class="btn btn-outline-light me-2" asp-area="" asp-controller="Accounts" asp-action="Index">
                        <i class="fa-solid fa-user"></i>
                    </a>
                    <a class="btn btn-outline-light position-relative" asp-area="" asp-controller="Cart" asp-action="Index">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            0
                            <span class="visually-hidden">items in cart</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container">
            <div class="row">
                <!-- About -->
                <div class="col-md-4">
                    <h5>About Us</h5>
                    <p>
                        We repurpose electronic components from old devices, turning e-waste into innovative solutions. Shop sustainably and make a difference.
                    </p>
                </div>
                <!-- Quick Links -->
                <div class="col-md-4">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="/Home/About" class="text-white">About</a></li>
                        <li><a href="/Products" class="text-white">Shop Components</a></li>
                        <li><a href="/Home/Contact" class="text-white">Contact</a></li>
                        <li><a href="/Home/FAQ" class="text-white">FAQ</a></li>
                    </ul>
                </div>
                <!-- Contact Info -->
                <div class="col-md-4">
                    <h5>Contact</h5>
                    <p>Email: support@ewastecomponents.com</p>
                    <p>Phone: +1 234 567 8901</p>
                    <p>Address: 123 Green Circuit, EcoCity</p>
                </div>
            </div>
            <hr class="bg-white" />
            <div class="text-center">
                <p class="mb-0">&copy; @DateTime.Now.Year eWaste Components. All rights reserved.</p>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
